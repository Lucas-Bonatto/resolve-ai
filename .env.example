# ResolveAI is safe to run without paid AI access.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai
RESOLVEAI_CODE_REVISION=unknown
DEMO_EVENT_DELAY_MS=180
MAX_AGENT_TURNS=12
MAX_TOOL_CALLS_PER_RUN=20
MAX_INVESTIGATION_SECONDS=120
ENABLE_REAL_AI=false
ENABLE_GITHUB_INTEGRATION=false
ENABLE_AGENTIC_WORKFLOWS=false
GITHUB_INTEGRATION_MODE=mock
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
